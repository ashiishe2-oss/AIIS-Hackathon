# Environment Mode (development, testing, production)
FLASK_ENV=development

# Application Security
FLASK_SECRET_KEY=replace_with_secure_random_secret

# Supabase Project Configuration
SUPABASE_URL=https://<project-ref>.supabase.co

# Public Publishable Anon Key (Safe for frontend clients; subject to Row Level Security)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Privileged Secret / Service Role Key (Server-only; bypasses RLS; NEVER expose to client or logs)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Supabase JWT Secret (Optional; used for legacy symmetric HS256 user token verification)
SUPABASE_JWT_SECRET=

# Direct PostgreSQL Connection URI (Optional; for direct pooler / psycopg access)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.<project-ref>.supabase.co:5432/postgres

# Allowed CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5000,http://localhost:3000
