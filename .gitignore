# ==============================================================================
# AIIS (Arogya Infrastructure Intelligence System) - Root .gitignore
# ==============================================================================

# Environment variables & secrets (CRITICAL)
.env
.env.*
*.env
!.env.example
*.pem
*.key
*.cert
*.crt

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Packaging & Distribution
build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Node / Frontend dependencies & caches
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*
.eslintcache

# Cloud & Deployment artifacts
.vercel/
vercel-log.txt

# IDEs & Developer Tooling
.idea/
.vscode/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# OS-specific files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs & temporary files
*.log
*.tmp
*.bak
